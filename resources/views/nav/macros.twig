{% macro menuItem(route, parameters, current, name, disabled) %}
    <li class="nav-item{% if route == current.getName() %} active{% endif %}{% if disabled %} disabled{% endif %}">
        <a class="nav-link text-light" href="{% if not disabled %}{{ route( route, parameters ) }}{% else %}#{% endif %}" title="{{ name }}">
            {{ name }}
        </a>
    </li>
{% endmacro %}

{% macro dropdownOpen(route, partialRoute, name, class) %}
    <li class="dropdown nav-item {{ class }}-menu{% if partialRoute in route.getName() %} active{% endif %}">
        <a href="#" class="nav-link text-light dropdown-toggle" id="{{ class }}-menu" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            {{ name }} <span class="caret"></span>
        </a>
        <div class="dropdown-menu bg-dark">
{% endmacro %}

{% macro dropdownItem(route, parameters, current, name, class, disabled) %}
    {% set linkUrl = route( route, parameters ) %}
    <a href="{{ linkUrl }}" class="{{ class }}-menu bg-dark text-light dropdown-item{% if linkUrl == url_current() %} active{% endif %}{% if disabled %} disabled{% endif %}" title="{{ name }}">{{ name }}</a>
{% endmacro %}

{% macro dropdownClose() %}
        </div>
    </li>
{% endmacro %}