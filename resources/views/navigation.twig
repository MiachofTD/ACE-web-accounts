{% import 'nav.macros' as nav %}

<nav class="navbar navbar-expand-sm navbar-dark bg-dark fixed-top" role="navigation" aria-expanded="true">
    <div class="container ace">
        <div class="navbar-header">
            <span class="navbar-brand">
                <img src="{{ public_asset( 'img/logo.png' ) }}" height="40" alt="ACEmulator Logo" />
            </span>
        </div>

        {% if exception is not defined and auth_user() is not empty %}
            <ul class="navbar-nav mr-auto">
                {{ nav.menuItem( 'dashboard', {}, currentRoute, 'Dashboard' ) }}

                {{ nav.dropdownOpen( currentRoute, 'profile', 'Profile', 'profile' ) }}
                    {{ nav.dropdownItem( 'profile.index', {}, currentRoute, 'My Profile', 'profile' ) }}
                    {{ nav.dropdownItem( 'characters.all', {}, currentRoute, 'Characters', 'profile' ) }}
                {{ nav.dropdownClose() }}

                {{ nav.menuItem( 'auth.logout', {}, currentRoute, 'Logout' ) }}

                <li>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</li>
                <li class="nav-item {{ serverStatus == 1 ? 'status-up' : 'status-down' }}">
                    {% set status = serverStatus == 1 ? 'On' : 'Off' %}
                    <a class="nav-link">Server Status: <strong>{{ status }}</strong></a>
                </li>
            </ul>
        {% endif %}


        {#<div id="main-navigation" class="collapse navbar-collapse">
            {% if exception is not defined and auth_user() is not empty %}
                {% include 'nav.base' %}
            {% endif %}#}
    </div>
</nav>



